<Window x:Class="ApexClicker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexClicker Mini Overlay v1.5"
        Height="58" Width="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource ColorCardBg}" 
            BorderBrush="{DynamicResource ColorAccent}" 
            BorderThickness="1.5" 
            CornerRadius="12" 
            Padding="8,5"
            MouseDown="Border_MouseDown"
            Cursor="SizeAll">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Play/Pause Button -->
                <ColumnDefinition Width="*"/>    <!-- Status & Stats -->
                <ColumnDefinition Width="Auto"/> <!-- Controls -->
            </Grid.ColumnDefinitions>

            <!-- Master Play / Pause Toggle Button -->
            <Button x:Name="BtnOverlayToggle" Grid.Column="0" Width="38" Height="38" Margin="2,0,10,0"
                    Background="{DynamicResource ColorSuccess}" Foreground="#11111b" Content="▶️" FontSize="16"
                    BorderThickness="0" Cursor="Hand" Click="BtnOverlayToggle_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Live Status & Stats -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtOverlayStatus" Text="STOPPED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorDanger}"/>
                    <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource ColorTextSecondary}"/>
                    <TextBlock x:Name="TxtOverlayMode" Text="Burst" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="TxtOverlayCps" Text="0 CPS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                    <TextBlock Text=" | " FontSize="10" Foreground="{DynamicResource ColorTextSecondary}" Margin="4,0"/>
                    <TextBlock x:Name="TxtOverlayClicks" Text="0 clicks" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls: Expand & Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- Expand back to Full Dashboard -->
                <Button x:Name="BtnExpand" Width="26" Height="26" Margin="2,0"
                        Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource ColorTextPrimary}"
                        BorderThickness="0" Cursor="Hand" ToolTip="Expand to Full Dashboard [Ctrl+M]" Click="BtnExpand_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="🗖" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close / Restore Button -->
                <Button x:Name="BtnClose" Width="26" Height="26" Margin="2,0"
                        Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource ColorDanger}"
                        BorderThickness="0" Cursor="Hand" ToolTip="Restore Full Window" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
