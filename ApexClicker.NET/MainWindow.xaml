<Window x:Class="ApexClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexClicker Pro v1.5.1 (Native .NET 9)" 
        Height="630" Width="1020"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorWindowBg}"
        Foreground="{DynamicResource ColorTextPrimary}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Sleek Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource ColorBorder}" CornerRadius="4" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                    <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsMouseOver}">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="{DynamicResource ColorBorder}" CornerRadius="4" Margin="2,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="true">
                                                                <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ColorCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{DynamicResource ColorSidebarBg}" 
                    BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource ColorAccent}" Margin="6,0,2,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ColorSidebarBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ColorBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ColorBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ColorSidebarBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Focusable="False" 
                                          ClickMode="Press"/>

                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="10,0,28,0" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource ColorSidebarBg}" 
                                        BorderBrush="{DynamicResource ColorAccent}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="4" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource ColorSidebarBg}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Row="0" Margin="4,6,4,14">
                    <TextBlock Text="⚡ APEXCLICKER" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}"/>
                    <TextBlock Text="PRO v1.5.1 • HIGH PERFORMANCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}" Margin="2,2,0,0"/>
                </StackPanel>

                <!-- Status & Stats Card -->
                <Border Grid.Row="1" Background="{DynamicResource ColorCardBg}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border x:Name="StatusBadgeBorder" Background="{DynamicResource ColorBorder}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtStatus" Text="● STOPPED [Ctrl+F6]" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorDanger}"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SPEED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock x:Name="TxtCps" Text="0 CPS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CLICKS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock x:Name="TxtClicks" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Big Master START / STOP Button & Compact Mode -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Button x:Name="BtnMasterToggle" Height="42" Content="▶️ START [Ctrl+F6]"
                            Background="{DynamicResource ColorSuccess}" Foreground="#11111b" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Margin="0,0,0,6" Click="BtnMasterToggle_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnCompactMode" Height="30" Content="🗗 Compact Overlay [Ctrl+M]"
                            Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource ColorTextPrimary}" FontSize="11" FontWeight="SemiBold"
                            Cursor="Hand" Click="BtnCompactMode_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Navigation List (Dynamically Filtered by Module Selector!) -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MODULES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ColorTextSecondary}" Margin="10,0,0,6"/>
                        
                        <Button x:Name="NavBurst" Style="{StaticResource SidebarNavBtn}" Content="⚡ Burst Clicker" Click="NavBurst_Click" Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource ColorAccent}" FontWeight="Bold"/>
                        <Button x:Name="NavSequence" Style="{StaticResource SidebarNavBtn}" Content="🎯 Multi-Point" Click="NavSequence_Click"/>
                        <Button x:Name="NavPixel" Style="{StaticResource SidebarNavBtn}" Content="👁️ Pixel Trigger" Click="NavPixel_Click"/>
                        <Button x:Name="NavVisual" Style="{StaticResource SidebarNavBtn}" Content="🖼️ Visual Bot" Click="NavVisual_Click"/>
                        <Button x:Name="NavKeySpam" Style="{StaticResource SidebarNavBtn}" Content="⌨️ Key Spammer" Click="NavKeySpam_Click"/>
                        <Button x:Name="NavMacro" Style="{StaticResource SidebarNavBtn}" Content="🎬 Macro Studio" Click="NavMacro_Click"/>
                        <Button x:Name="NavSettings" Style="{StaticResource SidebarNavBtn}" Content="⚙️ Settings &amp; Modules" Click="NavSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Hotkey Hint -->
                <TextBlock Grid.Row="4" Text="Hotkey: Ctrl+F6 toggles" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT VIEWS ================= -->
        <Grid Grid.Column="1" Background="{DynamicResource ColorWindowBg}">
            <!-- TAB 1: BURST CLICKER -->
            <ScrollViewer x:Name="ViewBurst" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="⚡ Burst Auto Clicker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>

                    <!-- Frequency Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Click Frequency &amp; Timing" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Target Speed (CPS):" FontSize="12" Foreground="{DynamicResource ColorTextPrimary}"/>
                                <TextBlock x:Name="TxtCpsSliderValue" Text="100 CPS (10 ms)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource ColorSuccess}"/>
                            </Grid>
                            
                            <Slider x:Name="SliderCps" Minimum="1" Maximum="1000" Value="100" ValueChanged="SliderCps_ValueChanged" Margin="0,4,0,10"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="10 CPS" Grid.Column="0" Style="{StaticResource ActionBtn}" Margin="2" Click="PresetCps_Click" Tag="10"/>
                                <Button Content="50 CPS" Grid.Column="1" Style="{StaticResource ActionBtn}" Margin="2" Click="PresetCps_Click" Tag="50"/>
                                <Button Content="100 CPS" Grid.Column="2" Style="{StaticResource ActionBtn}" Margin="2" Click="PresetCps_Click" Tag="100"/>
                                <Button Content="⚡ 1,000 CPS" Grid.Column="3" Background="{DynamicResource ColorAccent}" Foreground="#11111b" FontWeight="Bold" BorderThickness="0" Margin="2" Padding="8,4" Click="PresetCps_Click" Tag="1000"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action & Target Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Targeting &amp; Mouse Action" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Mouse Button:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbMouseButton" SelectedIndex="0" SelectionChanged="CmbMouseButton_SelectionChanged">
                                        <ComboBoxItem Content="Left Click"/>
                                        <ComboBoxItem Content="Right Click"/>
                                        <ComboBoxItem Content="Middle Click"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Click Mode:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbClickMode" SelectedIndex="0" SelectionChanged="CmbClickMode_SelectionChanged">
                                        <ComboBoxItem Content="Single Click"/>
                                        <ComboBoxItem Content="Double Click"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource ColorBorder}" Margin="0,8"/>

                            <RadioButton x:Name="RbCursor" GroupName="BurstTargetMode" Content="Follow Active Mouse Cursor" IsChecked="True" Foreground="{DynamicResource ColorTextPrimary}" Margin="0,4" Checked="RbTarget_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <RadioButton x:Name="RbFixed" GroupName="BurstTargetMode" Content="Fixed Coordinate: " Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Checked="RbTarget_Changed"/>
                                <TextBlock Text="X:" Foreground="{DynamicResource ColorAccent}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox x:Name="TbCoordX" Text="500" Width="60" Background="{DynamicResource ColorCardBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="4,2"/>
                                <TextBlock Text="Y:" Foreground="{DynamicResource ColorAccent}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox x:Name="TbCoordY" Text="500" Width="60" Background="{DynamicResource ColorCardBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="4,2"/>
                                <Button Content="🎯 Pick Coord" Style="{StaticResource ActionBtn}" Margin="10,0,0,0" Click="BtnPickCoord_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: MULTI-POINT SEQUENCE -->
            <ScrollViewer x:Name="ViewSequence" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🎯 Multi-Point Sequence" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Sequence Route Coordinates" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add Point" Style="{StaticResource ActionBtn}" Margin="4,0" Click="BtnAddSeqPoint_Click"/>
                                    <Button Content="🎯 Pick Active Point [Ctrl+F8]" Style="{StaticResource ActionBtn}" Margin="4,0" Click="BtnPickSeqCursor_Click"/>
                                    <Button Content="🗑️ Clear All" Style="{StaticResource ActionBtn}" Margin="4,0" Click="BtnClearSeq_Click"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="SequenceItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ColorSidebarBg}" CornerRadius="6" Padding="10" Margin="0,3" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Id, StringFormat='Point #{0}'}" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding X, StringFormat='X: {0} '}" Foreground="{DynamicResource ColorTextPrimary}" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DelayMs, StringFormat='Delay: {0}ms'}" Foreground="{DynamicResource ColorTextSecondary}" Grid.Column="2" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: PIXEL TRIGGER -->
            <ScrollViewer x:Name="ViewPixel" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="👁️ Pixel &amp; Color Reactive Trigger" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Pixel Sampling Point" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <TextBlock Text="X:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbPixelX" Text="100" Width="60" Margin="6,0,16,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="4,2"/>
                                <TextBlock Text="Y:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbPixelY" Text="100" Width="60" Margin="6,0,16,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="4,2"/>
                                <Button Content="👁️ Sample Pixel at Cursor [Ctrl+F9]" Style="{StaticResource ActionBtn}" Click="BtnSamplePixel_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <TextBlock Text="Target Color Preview:" Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                <Border x:Name="BorderPixelColorPreview" Background="#00FF00" Width="36" Height="24" CornerRadius="4" Margin="10,0"/>
                                <TextBlock x:Name="TxtPixelHex" Text="#00FF00" Foreground="{DynamicResource ColorAccent}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 4: VISUAL BOT & TEMPLATE SEARCH (UPGRADED WITH MULTI-QUEUE & PRESETS) -->
            <ScrollViewer x:Name="ViewVisual" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🖼️ Visual Bot &amp; Template Search" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT CARD: Multi-Target Library & Queue -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="4,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🖼️ Target Templates &amp; Queue" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,8"/>

                                <!-- Import Buttons -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnVisualPasteClip" Content="📋 Paste Clipboard" Grid.Column="0" Style="{StaticResource ActionBtn}" Background="{DynamicResource ColorAccent}" Foreground="#11111b" FontWeight="Bold" Margin="0,0,4,0" Height="34" Click="BtnVisualPasteClip_Click"/>
                                    <Button x:Name="BtnVisualAddFile" Content="📂 Add from File..." Grid.Column="1" Style="{StaticResource ActionBtn}" Margin="4,0,0,0" Height="34" Click="BtnVisualAddFile_Click"/>
                                </Grid>

                                <TextBlock Text="💡 Tip: Press Win+Shift+S to snip an element, then click Paste. Search multiple targets simultaneously!" FontSize="10" Foreground="{DynamicResource ColorTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <!-- Targets Header & List -->
                                <Grid Margin="0,4,0,4">
                                    <TextBlock x:Name="TxtVisualTargetCount" Text="TARGETS (0 Active)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Select All" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="10" Margin="3,0" Click="BtnVisualSelectAll_Click"/>
                                        <Button Content="Clear All" Style="{StaticResource ActionBtn}" Padding="8,3" FontSize="10" Margin="3,0" Click="BtnVisualClearAll_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ColorSidebarBg}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="8" Height="170" Margin="0,4,0,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="VisualTargetsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ColorCardBg}" CornerRadius="6" Padding="8,6" Margin="4,3" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ColorTextPrimary}"/>
                                                                <TextBlock Text="{Binding DisplayDetails}" FontSize="10" Foreground="{DynamicResource ColorTextSecondary}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="🗑️" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ColorDanger}" Cursor="Hand" Padding="6,2" Tag="{Binding Id}" Click="BtnVisualDeleteTarget_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Test Scan & Test Click Buttons -->
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnVisualTestClick" Content="🎯 Test &amp; Click Target" Grid.Column="0" Style="{StaticResource ActionBtn}" Margin="0,0,4,0" Height="32" Click="BtnVisualTestClick_Click"/>
                                    <Button x:Name="BtnVisualScanOnly" Content="🔍 Scan Only" Grid.Column="1" Style="{StaticResource ActionBtn}" Margin="4,0,0,0" Height="32" Click="BtnVisualScanOnly_Click"/>
                                </Grid>

                                <TextBlock x:Name="TxtVisualStatus" Text="Ready. Add or paste template images to begin." FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" TextWrapping="Wrap" Margin="2,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT CARD: Presets & Execution Settings -->
                        <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="6,0,4,0">
                            <StackPanel>
                                <TextBlock Text="⚙️ Presets &amp; Match Settings" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,8"/>

                                <!-- Presets Selector -->
                                <TextBlock Text="Saved Configuration Preset:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbVisualPresets" SelectedIndex="0" Grid.Column="0" Height="30"/>
                                    <Button Content="💾 Save" Grid.Column="1" Style="{StaticResource ActionBtn}" Margin="4,0,2,0" Padding="8,4" Click="BtnVisualSavePreset_Click"/>
                                    <Button Content="📂 Load" Grid.Column="2" Style="{StaticResource ActionBtn}" Margin="2,0,2,0" Padding="8,4" Click="BtnVisualLoadPreset_Click"/>
                                    <Button Content="🗑️" Grid.Column="3" Style="{StaticResource ActionBtn}" Margin="2,0,0,0" Padding="8,4" Click="BtnVisualDeletePreset_Click"/>
                                </Grid>

                                <!-- Precision Modes -->
                                <Grid Margin="0,2,0,2">
                                    <TextBlock Text="Match Precision:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtVisualConfVal" Text="60% (Similar)" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🎯 Exact (95%)" Grid.Column="0" Style="{StaticResource ActionBtn}" Margin="0,0,2,0" Padding="4,4" FontSize="10" Click="BtnPrecisionExact_Click"/>
                                    <Button Content="🔍 Similar (60%)" Grid.Column="1" Style="{StaticResource ActionBtn}" Margin="2,0,2,0" Padding="4,4" FontSize="10" Click="BtnPrecisionSimilar_Click"/>
                                    <Button Content="✨ Closest (45%)" Grid.Column="2" Style="{StaticResource ActionBtn}" Margin="2,0,0,0" Padding="4,4" FontSize="10" Click="BtnPrecisionClosest_Click"/>
                                </Grid>
                                <Slider x:Name="SliderVisualConf" Minimum="30" Maximum="99" Value="60" ValueChanged="SliderVisualConf_ValueChanged" Margin="0,2,0,8"/>

                                <!-- Target Selection Strategy (Highest Confidence vs Closest to Cursor) -->
                                <TextBlock Text="Target Selection Strategy:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,2,0,3"/>
                                <ComboBox x:Name="CmbVisualStrategy" SelectedIndex="0" Margin="0,0,0,6" SelectionChanged="CmbVisualStrategy_SelectionChanged">
                                    <ComboBoxItem Content="🎯 Highest Confidence (Best Match)"/>
                                    <ComboBoxItem Content="📍 Closest to Cursor (Nearest Match)"/>
                                </ComboBox>

                                <!-- Mouse Click Action & Travel -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Click Action:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbVisualAction" SelectedIndex="1" SelectionChanged="VisualSetting_Changed">
                                            <ComboBoxItem Content="Single Click"/>
                                            <ComboBoxItem Content="Double Click"/>
                                            <ComboBoxItem Content="Right Click"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Travel Speed:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbVisualSpeed" SelectedIndex="1" SelectionChanged="VisualSetting_Changed">
                                            <ComboBoxItem Content="⚡ Fast (0.15s)"/>
                                            <ComboBoxItem Content="🎯 Smooth (0.25s)"/>
                                            <ComboBoxItem Content="🐢 Gentle (0.40s)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="ChkVisualSmooth" Content="Smooth cursor glide (&quot;Move over&quot; naturally)" IsChecked="True" Foreground="{DynamicResource ColorTextPrimary}" Margin="0,2,0,6" Click="VisualSetting_Changed"/>

                                <!-- Timing: Cooldown & Interval in Seconds -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Cooldown (s):" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TbVisualCooldown" Text="0.5" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="6,3" LostFocus="TbVisualTiming_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Scan Interval (s):" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TbVisualInterval" Text="0.10" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="6,3" LostFocus="TbVisualTiming_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Queue Flow Mode -->
                                <TextBlock Text="Queue Flow Mode:" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,2,0,3"/>
                                <ComboBox x:Name="CmbVisualFlow" SelectedIndex="0" Margin="0,0,0,6" SelectionChanged="CmbVisualFlow_SelectionChanged">
                                    <ComboBoxItem Content="⚡ Any Match (Clicks whichever target is visible)"/>
                                    <ComboBoxItem Content="🔢 Ordered Steps (1 ➔ 2 ➔ 3)"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkVisualLoop" Content="🔁 Repeat queue continuously (loop)" IsChecked="True" Foreground="{DynamicResource ColorTextPrimary}" Margin="0,2,0,6" Click="VisualSetting_Changed"/>

                                <!-- Search Region Checkbox & Visual Controls -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <CheckBox x:Name="ChkUseRegion" Content="Restrict Search Area" Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Checked="ChkUseRegion_Changed" Unchecked="ChkUseRegion_Changed"/>
                                    <Button x:Name="BtnToggleAreaVisual" Content="👁️ Show Area Box" Style="{StaticResource ActionBtn}" Padding="8,2" FontSize="10" Margin="10,0,4,0" Click="BtnToggleAreaVisual_Click"/>
                                    <Button x:Name="BtnPickAreaScreen" Content="🎯 Drag / Pick" Style="{StaticResource ActionBtn}" Padding="8,2" FontSize="10" Margin="4,0,0,0" Click="BtnPickAreaScreen_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="X:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRegX" Text="100" Width="45" Margin="4,0,8,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="2" TextChanged="TbRegion_TextChanged"/>
                                    <TextBlock Text="Y:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRegY" Text="100" Width="45" Margin="4,0,8,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="2" TextChanged="TbRegion_TextChanged"/>
                                    <TextBlock Text="W:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRegW" Text="400" Width="45" Margin="4,0,8,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="2" TextChanged="TbRegion_TextChanged"/>
                                    <TextBlock Text="H:" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRegH" Text="300" Width="45" Margin="4,0,0,0" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="2" TextChanged="TbRegion_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 5: KEY SPAMMER -->
            <ScrollViewer x:Name="ViewKeySpam" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⌨️ Keyboard Auto-Presser &amp; Spammer" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Target Keys to Spam (comma-separated):" FontSize="12" Foreground="{DynamicResource ColorTextPrimary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TbKeySpamKeys" Text="1, 2, 3, E, Space" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="8,6" FontSize="13"/>
                            <TextBlock Text="Interval between key presses (ms):" FontSize="12" Foreground="{DynamicResource ColorTextPrimary}" Margin="0,12,0,6"/>
                            <TextBox x:Name="TbKeySpamInterval" Text="100" Width="100" HorizontalAlignment="Left" Background="{DynamicResource ColorSidebarBg}" Foreground="{DynamicResource ColorTextPrimary}" BorderBrush="{DynamicResource ColorBorder}" Padding="6,4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 6: MACRO STUDIO -->
            <ScrollViewer x:Name="ViewMacro" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🎬 Macro Recording Studio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Button x:Name="BtnMacroRecord" Content="⏺️ Start Recording [Ctrl+F10]" Height="36" Width="220" HorizontalAlignment="Left" Background="{DynamicResource ColorDanger}" Foreground="#11111b" FontWeight="Bold" BorderThickness="0" Click="BtnMacroRecord_Click"/>
                                <Button x:Name="BtnMacroPlay" Content="▶️ Play Macro" Height="36" Width="160" HorizontalAlignment="Right" Background="{DynamicResource ColorSuccess}" Foreground="#11111b" FontWeight="Bold" BorderThickness="0" Click="BtnMacroPlay_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtMacroEventsCount" Text="Recorded Events: 0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 7: SETTINGS, THEMES & MODULE SELECTOR -->
            <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚙️ Settings, Themes &amp; Module Manager" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" Margin="6,4,6,12"/>

                    <!-- THEMES SELECTOR -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="🎨 Visual Themes" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,6"/>
                            <TextBlock Text="Choose your preferred visual aesthetic (applied instantly across all panels):" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,0,10"/>
                            
                            <WrapPanel Margin="0,4">
                                <Button Content="🌑 Obsidian" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Obsidian" FontWeight="Bold"/>
                                <Button Content="⚫ Onyx (True Black)" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Onyx" FontWeight="Bold"/>
                                <Button Content="☕ Catppuccin Mocha" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Catppuccin" FontWeight="Bold"/>
                                <Button Content="⚡ Cyberpunk Neon" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Cyberpunk" FontWeight="Bold"/>
                                <Button Content="🌲 Emerald Stealth" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Emerald" FontWeight="Bold"/>
                                <Button Content="🩸 Crimson Blood" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Crimson" FontWeight="Bold"/>
                                <Button Content="❄️ Nordic Frost" Style="{StaticResource ActionBtn}" Margin="3" Click="ThemeBtn_Click" Tag="Nordic" FontWeight="Bold"/>
                            </WrapPanel>

                            <TextBlock x:Name="TxtActiveTheme" Text="Active Theme: Obsidian" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="4,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- MODULE SELECTOR (OPTION 1: ONLY INSTALL / SHOW WHAT PEOPLE WANT!) -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="📦 Component &amp; Tool Selector" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorAccent}" Margin="0,0,0,6"/>
                            <TextBlock Text="Only need a simple auto clicker? Uncheck the other tools and they disappear from your sidebar, keeping your app 100% clean and distraction-free." FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ModBurst" Content="⚡ Auto Clicker (Burst Engine)" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                            <CheckBox x:Name="ModSequence" Content="🎯 Multi-Point Sequence" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                            <CheckBox x:Name="ModPixel" Content="👁️ Pixel &amp; Color Trigger" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                            <CheckBox x:Name="ModVisual" Content="🖼️ Visual Bot &amp; Template Search" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                            <CheckBox x:Name="ModKeySpam" Content="⌨️ Keyboard Auto-Presser" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                            <CheckBox x:Name="ModMacro" Content="🎬 Macro Studio" Foreground="{DynamicResource ColorTextPrimary}" Margin="4" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
