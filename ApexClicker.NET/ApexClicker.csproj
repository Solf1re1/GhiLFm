<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyTitle>ApexClicker Pro v1.5.3</AssemblyTitle>
    <Product>ApexClicker Pro</Product>
    <Company>ApexClicker Team</Company>
    <Version>1.5.3</Version>
    <FileVersion>1.5.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

</Project>
