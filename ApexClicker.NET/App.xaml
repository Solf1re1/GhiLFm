<Application x:Class="ApexClicker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApexClicker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Fallback Default Brushes -->
        <SolidColorBrush x:Key="ColorWindowBg" Color="#0D0D12"/>
        <SolidColorBrush x:Key="ColorSidebarBg" Color="#08080C"/>
        <SolidColorBrush x:Key="ColorCardBg" Color="#15151C"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#252530"/>
        <SolidColorBrush x:Key="ColorTextPrimary" Color="#EDEDF2"/>
        <SolidColorBrush x:Key="ColorTextSecondary" Color="#828292"/>
        <SolidColorBrush x:Key="ColorAccent" Color="#A855F7"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#10B981"/>
        <SolidColorBrush x:Key="ColorDanger" Color="#F43F5E"/>
    </Application.Resources>
</Application>